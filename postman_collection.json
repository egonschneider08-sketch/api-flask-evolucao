{
  "info": {
    "name": "API Flask Books",
    "description": "Collection completa para testes dos endpoints da API Flask Books conectada ao PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "COLE_O_UUID_AQUI",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Status da API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Retorna o status online da aplicação Flask."
      }
    },
    {
      "name": "2. Listar Livros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        },
        "description": "Retorna uma lista com todos os livros gravados no banco PostgreSQL."
      }
    },
    {
      "name": "3. Criar Livro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"O Programador Pragmático\",\n  \"author\": \"Andy Hunt & Dave Thomas\",\n  \"description\": \"Um dos livros mais influentes sobre desenvolvimento de software profissional.\",\n  \"is_finished\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        },
        "description": "Cadastra um novo livro na base de dados com geração automática de UUID."
      }
    },
    {
      "name": "4. Buscar Livro por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["books", "{{bookId}}"]
        },
        "description": "Busca detalhes de um livro específico através do seu UUID."
      }
    },
    {
      "name": "5. Atualizar Livro",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"O Programador Pragmático (Edição Especial)\",\n  \"author\": \"Andy Hunt & Dave Thomas\",\n  \"description\": \"Edição comemorativa de 20 anos atualizada.\",\n  \"is_finished\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["books", "{{bookId}}"]
        },
        "description": "Atualiza os campos de um livro existente através do seu UUID."
      }
    },
    {
      "name": "6. Deletar Livro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": ["{{baseUrl}}"],
          "path": ["books", "{{bookId}}"]
        },
        "description": "Remove um livro do banco de dados."
      }
    }
  ]
}

